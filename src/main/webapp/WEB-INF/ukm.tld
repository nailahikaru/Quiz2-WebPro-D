<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
  <tlib-version>1.0</tlib-version>
  <short-name>u</short-name>
  <uri>http://ukmgenshin.local/functions</uri>

  <function>
    <description>Format tanggal/waktu (LocalDate, LocalDateTime, LocalTime)</description>
    <name>date</name>
    <function-class>com.ukmgenshin.util.Fmt</function-class>
    <function-signature>java.lang.String date(java.lang.Object, java.lang.String)</function-signature>
  </function>
  <function>
    <description>Nilai untuk input type=date (yyyy-MM-dd)</description>
    <name>iso</name>
    <function-class>com.ukmgenshin.util.Fmt</function-class>
    <function-signature>java.lang.String iso(java.lang.Object)</function-signature>
  </function>
  <function>
    <description>Format angka rupiah tanpa simbol, mis. 1.500.000</description>
    <name>rupiah</name>
    <function-class>com.ukmgenshin.util.Fmt</function-class>
    <function-signature>java.lang.String rupiah(long)</function-signature>
  </function>
  <function>
    <description>Escape HTML lalu ubah baris baru menjadi br</description>
    <name>nl2br</name>
    <function-class>com.ukmgenshin.util.Fmt</function-class>
    <function-signature>java.lang.String nl2br(java.lang.String)</function-signature>
  </function>
  <function>
    <description>Huruf pertama kapital</description>
    <name>initial</name>
    <function-class>com.ukmgenshin.util.Fmt</function-class>
    <function-signature>java.lang.String initial(java.lang.String)</function-signature>
  </function>
  <function>
    <description>Huruf pertama kapital pada teks</description>
    <name>ucfirst</name>
    <function-class>com.ukmgenshin.util.Fmt</function-class>
    <function-signature>java.lang.String ucfirst(java.lang.String)</function-signature>
  </function>
</taglib>
